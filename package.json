{
  "name": "deckbook",
  "version": "1.0.0",
  "description": "DeckBook educational cryptography demo",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "icons:native": "node scripts/generate-native-icons.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "android:device": "node scripts/android-device.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemslibrarian/DeckBook.git"
  },
  "keywords": [
    "cryptography",
    "education",
    "one-time-pad",
    "cipher"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/systemslibrarian/DeckBook/issues"
  },
  "homepage": "https://github.com/systemslibrarian/DeckBook#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/qrcode": "^1.5.6",
    "axe-core": "^4.12.1",
    "typescript": "^5.6.0",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "qrcode": "^1.5.4"
  }
}
